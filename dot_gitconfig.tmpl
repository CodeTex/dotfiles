[core]
    editor = vim
[init]
    defaultBranch = main
[fetch]
    prune = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[push]
    autoSetupRemote = true

{{- if .git.name }}
[user]
    name = {{ .git.name | quote }}
    email = {{ .git.email | quote }}
{{- end }}
