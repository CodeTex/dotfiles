. "$HOME/.local/bin/env"

# Load modular configuration
for file in "$HOME"/.zsh/conf.d/*.zsh(N); do
    source "$file"
done

# Load machine-local configuration
if [[ -r "$HOME/.config/.zsh/local.zsh" ]]; then
    source "$HOME/.config/.zsh/local.zsh"
fi

# Load secrets
if [[ -r "$HOME/.config/.zsh/secrets.zsh" ]]; then
    source "$HOME/.config/.zsh/secrets.zsh"
fi

# - alias ---
alias sf='source ~/.zshrc'
alias vf='vim ~/.zshrc'
alias va='vim ~/.zsh/conf.d/aliases.zsh'
alias ve='vim ~/.zsh/conf.d/environment.zsh'

alias ls='eza'
alias l='eza --long -bF'
alias ll='eza --long -a'
alias llm='eza --long -a --sort=modified'
alias la='eza -a --group-directories-first'
alias tree='eza --tree'

# - init ---
source <(fzf --zsh)
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# - wrapper ---
function fz() {
    fzf --style full \
        --preview 'fzf-preview.sh {}' \
        --bind 'focus:transform-header:file --brief {}' "$@"
}

function y() {
    local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}

