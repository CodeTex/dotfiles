. "$HOME/.local/bin/env"

# Load modular configuration
for file in "$HOME"/.zsh/conf.d/*.zsh(N); do
    source "$file"
done

# Load machine-local configuration
if [[ -r "$HOME/.zsh/local.zsh" ]]; then
    source "$HOME/.zsh/local.zsh"
fi

# Load secrets
if [[ -r "$HOME/.zsh/secrets.zsh" ]]; then
    source "$HOME/.zsh/secrets.zsh"
fi
# oMLX: CLI shim path begin
case ":$PATH:" in
  *":$HOME/.omlx/bin:"*) ;;
  *) export PATH="$HOME/.omlx/bin:$PATH" ;;
esac
# oMLX: CLI shim path end
