# Config shortcuts
alias sf='source ~/.zshrc'
alias vf='vim ~/.zshrc'
alias va='vim ~/.zsh/conf.d/aliases.zsh'
alias ve='vim ~/.zsh/conf.d/environment.zsh'

# eza shortcuts
alias ls='eza'
alias l='eza --long -bF'
alias ll='eza --long -a'
alias llm='eza --long -a --sort=modified'
alias la='eza -a --group-directories-first'
alias tree='eza --tree'
