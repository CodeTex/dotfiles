{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "share": "disabled",
  "server": {
    "port": 4096
  },
  // default models
  "default_agent": "plan",
  "model": "github-copilot/gpt-5.6-luna",
  // permissions
  // providers
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1"
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.5-0.8b-mlx": {
          "name": "Qwen3.5 0.8b MLX"
        }
      }
    }
  }
}
